# Copy to .env and fill in — used by the LLM agent (the in-sim review hook of
# `pm sim --scenario test_single_engineer_with_agent` and
# examples/run_agent_llm.py). .env is gitignored.

# Your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Optional: the model the in-sim LLM PM reviews with (any OpenRouter model id);
# defaults to openai/gpt-5.5-pro. The example takes the model as its first
# argument instead.
OPENROUTER_MODEL=

# Anthropic API key (https://console.anthropic.com/) — used by claude-* models
# in examples/run_claude_agent_llm.py.
ANTHROPIC_API_KEY=
