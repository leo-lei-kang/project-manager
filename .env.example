# Copy to .env and fill in — used by the PM agent (`pm-agent`). .env is gitignored.

# Your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# The model to drive the agent with (any OpenRouter model id), e.g.
#   anthropic/claude-3.5-sonnet | openai/gpt-4o-mini | google/gemini-2.0-flash-001
OPENROUTER_MODEL=

# The run `pm-agent` binds its tools to (defaults to "demo"). Usually passed
# inline instead: PM_RUN_ID=test_two_engineers uv run pm-agent "..."
#PM_RUN_ID=demo
